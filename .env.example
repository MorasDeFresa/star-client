# Endpoint GraphQL publico de SWAPI. No requiere autenticacion.
# El API solo responde correctamente en el servidor: el navegador recibe
# bloqueos de CORS, por eso toda consulta pasa por Apollo en el servidor.
SWAPI_GRAPHQL_URL=https://swapi-graphql.netlify.app/graphql

# Misma URL pero expuesta al bundle del navegador, usada por el cliente de
# Apollo para el scroll infinito y la paginacion del listado.
NEXT_PUBLIC_SWAPI_GRAPHQL_URL=https://swapi-graphql.netlify.app/graphql

# Origenes permitidos por el endpoint al recibir peticiones desde el servidor.
NEXT_PUBLIC_ORIGIN=http://localhost:3000
